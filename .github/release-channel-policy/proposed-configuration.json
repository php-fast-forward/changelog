{
  "app_registration": {
    "name": "Fast Forward Release Channels",
    "url": "https://github.com/php-fast-forward/changelog",
    "public": false,
    "webhook_active": false,
    "request_oauth_on_install": false,
    "permissions": {
      "contents": "write",
      "workflows": "write",
      "pull_requests": "read"
    },
    "events": []
  },
  "environment": {
    "name": "release-channels",
    "settings": {
      "wait_timer": 0,
      "prevent_self_review": true,
      "reviewers": [],
      "can_admins_bypass": false,
      "deployment_branch_policy": {
        "protected_branches": false,
        "custom_branch_policies": true
      }
    },
    "branch_policies": [
      {
        "name": "main",
        "type": "branch"
      }
    ],
    "variables": [
      "RELEASE_CHANNEL_APP_CLIENT_ID",
      "RELEASE_CHANNEL_APP_SLUG"
    ],
    "secrets": [
      "RELEASE_CHANNEL_APP_PRIVATE_KEY"
    ],
    "variable_values": {
      "RELEASE_CHANNEL_APP_CLIENT_ID": "Iv23liHqRng02H747IYa",
      "RELEASE_CHANNEL_APP_SLUG": "fast-forward-release-channels"
    }
  },
  "rulesets": [
    {
      "name": "v0 dedicated channel updater",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [
        {
          "actor_id": 5513989,
          "actor_type": "Integration",
          "bypass_mode": "always"
        }
      ],
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/v0"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "update",
          "parameters": {
            "update_allows_fetch_and_merge": false
          }
        }
      ]
    },
    {
      "name": "v0 channel integrity",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/v0"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "creation"
        },
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        }
      ]
    },
    {
      "name": "v0 reserved tag namespace",
      "target": "tag",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": [
            "refs/tags/v0"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "creation"
        },
        {
          "type": "update",
          "parameters": {
            "update_allows_fetch_and_merge": false
          }
        },
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        }
      ]
    }
  ],
  "identity": {
    "app_id": 5513989,
    "slug": "fast-forward-release-channels",
    "client_id": "Iv23liHqRng02H747IYa",
    "installation_id": 176263242,
    "owner": "php-fast-forward",
    "repository_selection": "all",
    "repositories_at_initial_provisioning": [
      "php-fast-forward/changelog"
    ]
  }
}
