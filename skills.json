{
    "$schema": "https://raw.githubusercontent.com/roxblnfk/skills/1.15.0/resources/skills.schema.json",
    "target": ".agents/skills",
    "aliases": [],
    "discovery": false,
    "auto-sync": true,
    "vendor-sources": false,
    "dependencies": {
        "composer": {
            "trusted": [
                "fast-forward/*"
            ],
            "trusted-replace": true
        }
    },
    "sources": [
        {
            "from": "dir",
            "path": "resources/skills"
        }
    ]
}
