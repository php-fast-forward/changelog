{
    "name": "fast-forward/changelog",
    "description": "Self-contained changelog CLI and automation for Fast Forward PHP packages.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "changelog",
        "cli",
        "fast-forward",
        "keep-a-changelog",
        "psr-11",
        "psr-20",
        "release-notes",
        "symfony-console"
    ],
    "readme": "README.md",
    "authors": [
        {
            "name": "Felipe Sayao Lobato Abreu",
            "email": "github@mentordosnerds.com",
            "homepage": "https://github.com/coisa",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/php-fast-forward/changelog",
    "support": {
        "issues": "https://github.com/php-fast-forward/changelog/issues",
        "wiki": "https://github.com/php-fast-forward/changelog/wiki",
        "source": "https://github.com/php-fast-forward/changelog",
        "docs": "https://php-fast-forward.github.io/changelog/"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/php-fast-forward"
        },
        {
            "type": "custom",
            "url": "https://www.paypal.com/donate/?business=JLDAF45XZ8D84"
        }
    ],
    "require": {
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-phar": "*",
        "ext-tokenizer": "*",
        "ext-zlib": "*",
        "php": "^8.3"
    },
    "require-dev": {
        "composer-runtime-api": "^2.2",
        "container-interop/service-provider": "^0.4.1",
        "ext-simplexml": "*",
        "fast-forward/clock": "^1.1.3",
        "fast-forward/config": "^1.7.4",
        "fast-forward/container": "^1.10.1",
        "fast-forward/phpdoc-bootstrap-template": "^2.2.4",
        "league/commonmark": "^2.10.7",
        "llm/skills": "^1.17.0",
        "nikic/php-parser": "^5.9.0",
        "phpdocumentor/shim": "^3.10.0",
        "phpspec/prophecy": "^1.26.1",
        "phpspec/prophecy-phpunit": "^2.5.0",
        "phpstan/phpdoc-parser": "^2.4.1",
        "phpunit/php-code-coverage": "^12.5.8",
        "phpunit/phpunit": "^12.5.44",
        "psr/clock": "^1.0.0",
        "psr/container": "^2.0.2",
        "rector/rector": "^2.8.4",
        "symfony/console": "^7.4.23",
        "symfony/filesystem": "^7.4.23",
        "symfony/finder": "^7.4.23",
        "symfony/http-client": "^7.4.23",
        "symfony/lock": "^7.4.23",
        "symfony/polyfill-php84": "^1.43.0",
        "symfony/polyfill-php85": "^1.43.0",
        "symfony/process": "^7.4.22",
        "symfony/translation-contracts": "^3.8.1",
        "symfony/validator": "^7.4.23",
        "symfony/yaml": "^7.4.23",
        "symplify/easy-coding-standard": "^13.3.17",
        "thecodingmachine/safe": "^3.4.0"
    },
    "suggest": {
        "llm/skills": "Optionally synchronize the bundled agent skill in consumer projects."
    },
    "minimum-stability": "stable",
    "autoload-dev": {
        "psr-4": {
            "FastForward\\Changelog\\": "src/",
            "FastForward\\Changelog\\Tests\\": "tests/"
        }
    },
    "bin": [
        "dist/changelog"
    ],
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "llm/skills": true,
            "phpdocumentor/shim": true
        }
    },
    "extra": {
        "skills": {
            "source": "resources/skills"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "phar": {
            "runtime-packages": [
                "container-interop/service-provider",
                "fast-forward/clock",
                "fast-forward/config",
                "fast-forward/container",
                "league/commonmark",
                "psr/clock",
                "psr/container",
                "symfony/console",
                "symfony/filesystem",
                "symfony/finder",
                "symfony/http-client",
                "symfony/lock",
                "symfony/process",
                "symfony/validator",
                "symfony/yaml",
                "thecodingmachine/safe",
                "symfony/polyfill-php84",
                "symfony/polyfill-php85"
            ],
            "runtime-conflicts": {
                "php-di/php-di": "<7.0.7",
                "symfony/polyfill-php83": "<1.30",
                "symfony/translation-contracts": "<2.5.3 || >=3.0,<3.4.2"
            }
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration --no-coverage",
        "test:workflows": "@php tests/Workflow/verify.php",
        "test:packaging": "@php tests/Packaging/verify.php",
        "test:coverage": [
            "@php -d pcov.enabled=1 -d pcov.directory=src -d xdebug.mode=coverage vendor/bin/phpunit --testsuite unit --coverage-cobertura=.build/coverage.xml --coverage-clover=.build/clover.xml --coverage-text --coverage-html=.build/coverage",
            "@php tests/verify-coverage.php .build/coverage.xml 100"
        ],
        "lint": "@php scripts/lint.php",
        "phpdoc": "@php scripts/phpdoc.php",
        "docs:build": "@php vendor/bin/phpdoc --config=phpdoc.dist.xml --no-progress",
        "coverage:check": "@test:coverage",
        "quality:verify": "@php scripts/verify-quality.php",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "quality": [
            "@lint",
            "@phpdoc",
            "@quality:verify",
            "@rector",
            "@ecs"
        ],
        "check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@quality",
            "@test:coverage"
        ]
    }
}
